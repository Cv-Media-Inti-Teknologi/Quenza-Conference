{% extends 'public.html.twig' %}

{% block title %}Beranda{% endblock %}

{% block page %}
<h1 class="text-3xl font-bold tracking-tight">Selamat datang di Oceri</h1>
<p class="mt-3 text-gray-600">
    Base project Quenza Conference System — Slim 4 + SQLite + Twig + Tailwind (CDN).
</p>

<div class="mt-8 max-w-xl rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <p class="font-medium">Contoh data dari server:</p>
    <ul class="mt-2 space-y-1 text-sm text-gray-700">
        <li>Nama acara: <b>{{ event.name }}</b></li>
        <li>Tanggal: <b>{{ event.date }}</b></li>
    </ul>
</div>
{% endblock %}
